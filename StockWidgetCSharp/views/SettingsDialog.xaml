<Window x:Class="StockWidget.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        Width="560" Height="540">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="10,8,10,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="10,2"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="26"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="#DCDCDC" BorderThickness="0,1,0,0" Padding="10,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="确认" Width="76" Margin="0,0,8,0" IsDefault="True" Click="OnOk"/>
                <Button Content="取消" Width="76" Margin="0,0,8,0" IsCancel="True" Click="OnCancel"/>
                <Button Content="应用" Width="76" Click="OnApply"/>
            </StackPanel>
        </Border>
        <TabControl x:Name="Tabs" Padding="10" Margin="8"/>
    </DockPanel>
</Window>
