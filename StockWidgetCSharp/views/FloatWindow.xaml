<Window x:Class="StockWidget.FloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StockWidget"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        MouseDown="OnMouseDown"
        MouseMove="OnMouseMove"
        MouseUp="OnMouseUp"
        MouseDoubleClick="OnMouseDoubleClick">
    <Border x:Name="PanelBorder" CornerRadius="5" Padding="0">
        <StackPanel x:Name="RootPanel">
            <!-- 错误提示 -->
            <TextBlock x:Name="ErrorLabel" Visibility="Collapsed"
                       Foreground="#ff6666" Padding="4,2" FontSize="10"/>
            <!-- 行情表格（代码动态构建） -->
            <Grid x:Name="TableGrid"/>
            <TextBlock x:Name="PositionSummaryLabel"
                       Visibility="Collapsed"
                       Padding="4,2"
                       TextAlignment="Left"/>
        </StackPanel>
    </Border>
</Window>
