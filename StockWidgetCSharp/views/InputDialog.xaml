<Window x:Class="StockWidget.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        Width="320">
    <StackPanel Margin="12">
        <TextBlock x:Name="Prompt" Margin="0,0,0,6"/>
        <TextBox x:Name="Input" Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkBtn" Content="确定" Width="72" Margin="0,0,8,0" IsDefault="True" Click="OnOk"/>
            <Button Content="取消" Width="72" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
