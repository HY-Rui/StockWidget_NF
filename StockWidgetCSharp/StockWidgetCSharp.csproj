<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>StockWidget</AssemblyName>
    <RootNamespace>StockWidget</RootNamespace>
    <ApplicationIcon>StockWidget.ico</ApplicationIcon>
    <OutDir>..\dist\StockWidgetCSharp\</OutDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!-- 移除 WinForms/System.Drawing 的全局 using，避免与 WPF 类型冲突 -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Drawing.*" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- gbk 编码支持（新浪接口用 gbk） -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="StockWidget.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
